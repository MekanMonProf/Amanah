# ---------------------------------------------------------------------------
# AMANAH — modèle d'environnement de production (amanah.waqfdolelxamxam.sn)
#
# À copier en .env SUR LE SERVEUR, puis à compléter aux cinq endroits marqués
# « À REMPLIR ». Ce fichier-ci ne contient aucun secret et peut rester dans le
# dépôt ; le .env rempli, lui, n'y entre jamais.
#
# Hébergement mutualisé cPanel, sans SSH : pas de cron, pas de worker, pas de
# Redis. Sessions, cache et file d'attente passent par la base de données.
# ---------------------------------------------------------------------------

APP_NAME=AMANAH
APP_ENV=production

# À REMPLIR (1/4) — clé de chiffrement, indispensable.
# Elle chiffre les sessions et les cookies. Si elle change, tout le monde est
# déconnecté ; si elle est vide, l'application refuse de démarrer.
# Générée par « php artisan key:generate --show », ou fournie par moi.
APP_KEY=

# Jamais true en production : une erreur afficherait le code, les requêtes SQL
# et le contenu de ce fichier à quiconque tombe dessus.
APP_DEBUG=false

APP_URL=https://amanah.waqfdolelxamxam.sn

APP_LOCALE=fr
APP_FALLBACK_LOCALE=fr
APP_FAKER_LOCALE=fr_FR

APP_MAINTENANCE_DRIVER=file
BCRYPT_ROUNDS=12

LOG_CHANNEL=stack
LOG_STACK=single
LOG_DEPRECATIONS_CHANNEL=null
# En production on ne garde que ce qui mérite d'être lu.
LOG_LEVEL=warning

# --- Base de données -------------------------------------------------------
# LA BASE EXISTANTE, celle de l'application déjà en ligne.
#
# Le forfait n'en autorise qu'une : AMANAH pose donc ses 25 tables à côté des
# 14 qui s'y trouvent déjà. Vérifié : aucun nom n'est commun aux deux jeux,
# et les migrations d'AMANAH ne touchent que les siennes.
#
# Deux conséquences à ne pas perdre de vue :
#   - migrate:fresh, migrate:refresh, migrate:reset et db:wipe videraient TOUTE
#     la base, anciennes tables comprises. APP_ENV=production les interdit
#     (voir AppServiceProvider) — raison de plus pour ne pas y toucher.
#   - la sauvegarde emporte les deux applications d'un coup, ce qui est plutôt
#     une bonne chose.
DB_CONNECTION=mysql
DB_HOST=127.0.0.1
DB_PORT=3306
# À REMPLIR (2/4) — les identifiants de la base EXISTANTE, tels que cPanel les
# donne. L'utilisateur doit avoir le droit de créer des tables.
DB_DATABASE=
DB_USERNAME=
DB_PASSWORD=

# --- Session, cache, file d'attente ---------------------------------------
SESSION_DRIVER=database
SESSION_LIFETIME=120
# Les cookies ne partent que par HTTPS, et restent illisibles au JavaScript.
SESSION_ENCRYPT=true
SESSION_PATH=/
SESSION_DOMAIN=.waqfdolelxamxam.sn
SESSION_SECURE_COOKIE=true
SESSION_HTTP_ONLY=true
SESSION_SAME_SITE=lax

CACHE_STORE=database
QUEUE_CONNECTION=database
BROADCAST_CONNECTION=log

# Le disque local : storage/app/private, hors de la racine web. Les pièces
# jointes n'y sont jamais servies directement, elles passent par un contrôleur
# qui vérifie les droits avant de rendre le fichier.
FILESYSTEM_DISK=local

# --- Courrier --------------------------------------------------------------
# À REMPLIR (3/4) — SMTP de l'hébergeur, ou de votre fournisseur de messagerie.
# Laisser MAIL_MAILER=log désactive l'envoi sans rien casser : l'application
# continue de marcher, les identifiants partent alors par WhatsApp seulement.
MAIL_MAILER=smtp
MAIL_HOST=
MAIL_PORT=587
MAIL_SCHEME=tls
MAIL_USERNAME=
MAIL_PASSWORD=
MAIL_FROM_ADDRESS=
MAIL_FROM_NAME="${APP_NAME}"

# --- Réglages propres à AMANAH --------------------------------------------

# Lecture des pièces d'identité : OCR local. Un hébergement mutualisé n'a
# presque jamais Tesseract installé — laisser vide désactive la lecture
# automatique, la saisie reste manuelle. Rien d'autre n'en dépend.
TESSERACT_BIN=

# Numéro WhatsApp de support, joint aux identifiants envoyés aux investisseurs.
AMANAH_WHATSAPP_SUPPORT=+221 78 127 44 76

# Combien de jours un lien de reçu reste valable.
AMANAH_VALIDITE_RECU_JOURS=30

# À REMPLIR (4/4) — le premier administrateur, créé par ParametresInitiauxSeeder
# sur une base neuve. Son mot de passe est tiré au hasard et affiché une seule
# fois ; il devra le changer à la première connexion.
AMANAH_ADMIN_EMAIL=
AMANAH_ADMIN_NOM=
AMANAH_ADMIN_PRENOM=

# Reprise de l'ancienne application — RIEN À REMPLIR ICI.
#
# Les anciennes tables sont dans la même base que celles d'AMANAH : la commande
# d'import les y trouve toute seule, en vérifiant la présence de utilisateurs,
# releves et antennes avant de lire quoi que ce soit.
#
# Ces lignes ne servent que si un jour l'ancienne application déménage dans une
# base séparée. Les laisser vides est le cas normal.
ANCIENNE_DB_HOST=127.0.0.1
ANCIENNE_DB_PORT=3306
ANCIENNE_DB_DATABASE=
ANCIENNE_DB_USERNAME=
ANCIENNE_DB_PASSWORD=
