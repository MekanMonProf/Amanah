# ---------------------------------------------------------------------------
# AMANAH — modèle d'environnement de production (amanah.waqfdolelxamxam.sn)
#
# À copier en .env SUR LE SERVEUR, puis à compléter aux cinq endroits marqués
# « À REMPLIR ». Ce fichier-ci ne contient aucun secret et peut rester dans le
# dépôt ; le .env rempli, lui, n'y entre jamais.
#
# Hébergement mutualisé cPanel, sans SSH : pas de cron, pas de worker, pas de
# Redis. Sessions, cache et file d'attente passent par la base de données.
# ---------------------------------------------------------------------------

APP_NAME=AMANAH
APP_ENV=production

# À REMPLIR (1/5) — clé de chiffrement, indispensable.
# Elle chiffre les sessions et les cookies. Si elle change, tout le monde est
# déconnecté ; si elle est vide, l'application refuse de démarrer.
# Générée par « php artisan key:generate --show », ou fournie par moi.
APP_KEY=

# Jamais true en production : une erreur afficherait le code, les requêtes SQL
# et le contenu de ce fichier à quiconque tombe dessus.
APP_DEBUG=false

APP_URL=https://amanah.waqfdolelxamxam.sn

APP_LOCALE=fr
APP_FALLBACK_LOCALE=fr
APP_FAKER_LOCALE=fr_FR

APP_MAINTENANCE_DRIVER=file
BCRYPT_ROUNDS=12

LOG_CHANNEL=stack
LOG_STACK=single
LOG_DEPRECATIONS_CHANNEL=null
# En production on ne garde que ce qui mérite d'être lu.
LOG_LEVEL=warning

# --- Base de données -------------------------------------------------------
# Une base PROPRE À AMANAH, à créer dans cPanel > Bases de données MySQL.
# Elle ne remplace pas et ne touche pas celle de l'application existante : les
# deux cohabitent sur le même serveur sans se voir.
# cPanel préfixe les noms par votre compte, d'où la forme « compte_amanah ».
DB_CONNECTION=mysql
DB_HOST=127.0.0.1
DB_PORT=3306
# À REMPLIR (2/5) — nom, utilisateur et mot de passe donnés par cPanel.
DB_DATABASE=
DB_USERNAME=
DB_PASSWORD=

# --- Session, cache, file d'attente ---------------------------------------
SESSION_DRIVER=database
SESSION_LIFETIME=120
# Les cookies ne partent que par HTTPS, et restent illisibles au JavaScript.
SESSION_ENCRYPT=true
SESSION_PATH=/
SESSION_DOMAIN=.waqfdolelxamxam.sn
SESSION_SECURE_COOKIE=true
SESSION_HTTP_ONLY=true
SESSION_SAME_SITE=lax

CACHE_STORE=database
QUEUE_CONNECTION=database
BROADCAST_CONNECTION=log

# Le disque local : storage/app/private, hors de la racine web. Les pièces
# jointes n'y sont jamais servies directement, elles passent par un contrôleur
# qui vérifie les droits avant de rendre le fichier.
FILESYSTEM_DISK=local

# --- Courrier --------------------------------------------------------------
# À REMPLIR (3/5) — SMTP de l'hébergeur, ou de votre fournisseur de messagerie.
# Laisser MAIL_MAILER=log désactive l'envoi sans rien casser : l'application
# continue de marcher, les identifiants partent alors par WhatsApp seulement.
MAIL_MAILER=smtp
MAIL_HOST=
MAIL_PORT=587
MAIL_SCHEME=tls
MAIL_USERNAME=
MAIL_PASSWORD=
MAIL_FROM_ADDRESS=
MAIL_FROM_NAME="${APP_NAME}"

# --- Réglages propres à AMANAH --------------------------------------------

# Lecture des pièces d'identité : OCR local. Un hébergement mutualisé n'a
# presque jamais Tesseract installé — laisser vide désactive la lecture
# automatique, la saisie reste manuelle. Rien d'autre n'en dépend.
TESSERACT_BIN=

# Numéro WhatsApp de support, joint aux identifiants envoyés aux investisseurs.
AMANAH_WHATSAPP_SUPPORT=+221 78 127 44 76

# Combien de jours un lien de reçu reste valable.
AMANAH_VALIDITE_RECU_JOURS=30

# À REMPLIR (4/5) — le premier administrateur, créé par ParametresInitiauxSeeder
# sur une base neuve. Son mot de passe est tiré au hasard et affiché une seule
# fois ; il devra le changer à la première connexion.
AMANAH_ADMIN_EMAIL=
AMANAH_ADMIN_NOM=
AMANAH_ADMIN_PRENOM=

# À REMPLIR (5/5) — reprise de l'ancienne application.
# Coordonnées de la base MySQL existante, en LECTURE SEULE : la commande
# d'import s'y connecte pour lire, jamais pour écrire. À retirer de ce fichier
# une fois la reprise terminée et vérifiée.
ANCIENNE_DB_HOST=127.0.0.1
ANCIENNE_DB_PORT=3306
ANCIENNE_DB_DATABASE=
ANCIENNE_DB_USERNAME=
ANCIENNE_DB_PASSWORD=
